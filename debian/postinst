#!/bin/sh
set -e

case "$1" in
    configure)
        modprobe msr 2>/dev/null || true
        monitor_turbostat="$(command -v turbostat 2>/dev/null || true)"
        if [ -n "$monitor_turbostat" ]; then
            setcap cap_sys_rawio,cap_sys_nice,cap_sys_admin=ep "$monitor_turbostat" || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
